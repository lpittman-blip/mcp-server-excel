{
  "mcpServers": {
    "excel-mcp": {
      "command": "mcp-excel"
    },
    "cutline-api": {
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-File",
        "scripts/start-cutline-api-mcp.ps1"
      ],
      "env": {
        "CUTLINE_API_URL": "${CUTLINE_API_URL}",
        "CUTLINE_REPO_ROOT": "${CUTLINE_REPO_ROOT}"
      }
    }
  }
}
